# ============ 大模型（DeepSeek，OpenAI 兼容接口） ============
# 前端不再直接调大模型，所有对话走后端 /api/chat
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ============ 服务端口 ============
PORT=3000

# ============ WebPush VAPID 密钥 ============
# 用命令生成：npx web-push generate-vapid-keys
# 私钥务必只放这里，绝不上传 github（.gitignore 已屏蔽 .env）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ============ 可选：Azure TTS（密钥全在后端，无则前端用浏览器原生语音） ============
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# ============ 数据目录（默认 server/data，单文件 sqlite） ============
# DATA_DIR=/path/to/data
